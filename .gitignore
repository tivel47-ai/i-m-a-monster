# Godot 4+ specific ignores
.godot/
/android/

# Incoming recordings and runtime audio pending review.
# List reviewed WAV files and their Godot import settings below.
/assets/audio/_incoming/*
!/assets/audio/_incoming/.gdignore
/assets/audio/local/**
!/assets/audio/local/**/

